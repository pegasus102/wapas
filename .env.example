# Optional. Only needed if you run scripts/run_batch.py --live or
# scripts/live_demo.py, which let the diagnosis agent call a REAL LLM on
# ambiguous events instead of the offline stand-in. Responses are cached in
# cache/diagnosis_cache_live.json, so you only pay API calls once.
# `make all` / `make batch` (default, no flags) never need any key.

# OpenRouter (recommended: free models available) — get a key at
# https://openrouter.ai/ -> Keys -> Create Key
OPENROUTER_API_KEY=
# Optional; defaults to a free-tier model. Any OpenRouter model id works.
# Free catalogs churn — if a model 404s, list what's free today:
#   curl -s https://openrouter.ai/api/v1/models | python3 -c 'import sys,json; [print(m["id"]) for m in json.load(sys.stdin)["data"] if m["id"].endswith(":free")]'
# Verified live 2026-09-05: google/gemma-4-31b-it:free, z-ai/glm-5.2:free,
# minimax/minimax-m3:free, nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Alternative direct provider (optional; OpenRouter is preferred)
ANTHROPIC_API_KEY=
